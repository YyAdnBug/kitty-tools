<Project>
  <!--
    内置智谱 API Key 的模板。复制成 windows/Secrets.props（不入库），把 key 填在下面；
    构建时写进程序集元数据 KittyBuiltinZhipuKey，运行时 ZhipuProvider 在没有用户 key 时用它。
    可以和 mac 版共用同一个 key（macos/Config/Secrets.xcconfig 里的 KittyBuiltinZhipuKey）。
  -->
  <PropertyGroup>
    <KittyBuiltinZhipuKey></KittyBuiltinZhipuKey>
  </PropertyGroup>
</Project>
