<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Kitty Tools 的 Windows 原生版（第 0 批验证样机）。
    无包（WindowsPackageType=None）+ 自包含 Windows App SDK + Native AOT。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>KittyTools</RootNamespace>
    <AssemblyName>KittyTools</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>
    <!-- PLAN-v6 第 5 批：逐项量过的 AOT 选项，只留省了、没变慢的。 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWin32PlatformTarget Condition="'$(Platform)' == 'x64'">x64</CsWin32PlatformTarget>
    <CsWin32PlatformTarget Condition="'$(Platform)' == 'ARM64'">arm64</CsWin32PlatformTarget>
    <CsWin32PlatformTarget Condition="'$(CsWin32PlatformTarget)' == ''">x64</CsWin32PlatformTarget>
    <!--
      exe 版本信息里的「文件说明」「产品名」：任务管理器、设置 › 任务栏「其他系统托盘图标」、文件属性显示的名字。
      不写的话两个都是程序集名 KittyTools。Debug 叫 Kitty Tools Dev，和装着的正式版分开（2026-10-27 用户要求；
      Paths.ProductName 在 Debug 下也是「Kitty Tools Dev」）。
    -->
    <AssemblyTitle>Kitty Tools</AssemblyTitle>
    <Product>Kitty Tools</Product>
    <AssemblyTitle Condition="'$(Configuration)' == 'Debug'">Kitty Tools Dev</AssemblyTitle>
    <Product Condition="'$(Configuration)' == 'Debug'">Kitty Tools Dev</Product>
  </PropertyGroup>
  <!--
    2026-11-04 GHSA-p3jp-9v83-76w9（CVE-2026-111497，.NET 的 Brotli 解码越界写）：本机 SDK 10.0.402 自带的 AOT 编译器和运行时是
    10.0.13，还原时报 NU1903（警告当错误）、AOT 发布不出来。发布时把 SDK 自带清单里的运行时包和 AOT 编译器包改成修好的 10.0.14
    （AOT 把运行时编进 exe，两样都要新；不用 RuntimeFrameworkVersion，它会连 Windows SDK 投影包的版本一起改坏）；
    运行时只在发布时改：Debug 是依赖框架运行的，改了本机没装 10.0.14 运行时就起不来；编译器包 Debug 也会还原（PublishAot 带的
    分析器），一直改。装了带 10.0.14 的 SDK 以后这一段可以删掉。
  -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(_IsPublishing)' == 'true'">
    <KnownFrameworkReference Update="Microsoft.NETCore.App" LatestRuntimeFrameworkVersion="10.0.14" />
    <KnownRuntimePack Update="Microsoft.NETCore.App" LatestRuntimeFrameworkVersion="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- R27：让 GC 在空闲时更积极地把不用的堆还给系统；只影响回收节奏，不压工作集。 -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只引组件包：聚合包会带进 AI / ML / Search / Widgets，发布目录多 50 多 MB。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KittyTools.Core\KittyTools.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 托盘的两种状态图标（Shell/Tray.cs 按路径读）：录制中右下角红点、暂停记录剪贴板时灰色暂停角标（PLAN-v11 F9）。 -->
    <Content Include="Resources\AppIconRecording.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\AppIconPaused.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\changelog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 翻译服务的 logo（ms-appx:///Resources/ServiceLogo/*.png）：WinUI 把它们收成默认 Content，build 时会拷，publish 不拷；
         不标 CopyToOutputDirectory 的话发布包里一张都没有，设置和卡片上全是色块首字（2026-10-28 真机反馈的「logo 缺」）。 -->
    <Content Update="Resources\ServiceLogo\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 状态屏的动画表情（PLAN-v12 N5）：帧图集 + 静止画面（ms-appx:///Resources/StatusEmoji/*.png，同上要标 PreserveNewest 才进发布包）、
         帧时长清单（按路径读）和素材的 MIT 许可全文（关于页「许可」打开它）。在 Mac 上用 tools/status-emoji.swift 生成。 -->
    <Content Update="Resources\StatusEmoji\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\StatusEmoji\manifest.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\StatusEmoji\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NativeMethods.txt" />
    <None Include="NativeMethods.json" />
  </ItemGroup>
  <!-- 内置智谱 key：windows/Secrets.props 不入库（模板 windows/Secrets.props.example），构建时写进程序集元数据。
       以前这里只认工程目录下的 Secrets.props，和模板说的位置对不上；两处都认，工程目录那份也已加进 .gitignore。 -->
  <Import Project="..\Secrets.props" Condition="Exists('..\Secrets.props')" />
  <Import Project="Secrets.props" Condition="!Exists('..\Secrets.props') And Exists('Secrets.props')" />
  <ItemGroup Condition="'$(KittyBuiltinZhipuKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KittyBuiltinZhipuKey</_Parameter1>
      <_Parameter2>$(KittyBuiltinZhipuKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!--
    Native AOT 的 publish 不会把 WinUI 生成的 KittyTools.pri 带进发布目录；缺了它
    Application.LoadComponent 在 Release AOT 下会抛 XamlParseException（浮层里的 XAML 面板打不开）。
    这里在 publish 之后补一份，zip 里的发布物才完整。
  -->
  <Target Name="CopyPriFileToPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
  <!--
    发布目录里缺 PRI 的后果（第二版 §6 第 2 批查清的根因）：
    主题资源（CardBackgroundFillColorDefaultBrush 等）全部查不到、任何 XAML 面板在 LoadComponent 时
    抛 XamlParseException，NavigationView 的样式也画不出来。缺了就当场报错，不要发出这样的包。
  -->
  <Target Name="VerifyPriInPublish" AfterTargets="CopyPriFileToPublish">
    <Error
      Condition="!Exists('$(PublishDir)$(AssemblyName).pri')"
      Text="发布目录里没有 $(AssemblyName).pri：XAML 面板和主题资源都会失效（见 PLAN-v2 §6 第 2 批）。" />
    <Error
      Condition="!Exists('$(PublishDir)Microsoft.UI.Xaml.Controls.pri')"
      Text="发布目录里没有 Microsoft.UI.Xaml.Controls.pri：NavigationView 等控件的样式会缺失。" />
  </Target>
</Project>
