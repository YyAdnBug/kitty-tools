<?xml version="1.0" encoding="utf-8"?>
<!--
  PLAN-v7 §2.1：界面刻度。圆角、字号、间距、颜色只从这里取，代码里不再 new 画刷、不再写字面量。
  深浅色 / 高对比度各一套；高对比度一律映射到系统色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Kitty.Fill.Hover" Color="#0A000000" />
            <SolidColorBrush x:Key="Kitty.Fill.Selected" Color="#12000000" />
            <SolidColorBrush x:Key="Kitty.Fill.Control" Color="#0F000000" />
            <SolidColorBrush x:Key="Kitty.Hairline" Color="#14000000" />
            <SolidColorBrush x:Key="Kitty.Card" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="Kitty.CardSolid" Color="#FBFBFB" />
            <SolidColorBrush x:Key="Kitty.Input" Color="#0B000000" />
            <SolidColorBrush x:Key="Kitty.Accent" Color="#FF4D7E" />
            <SolidColorBrush x:Key="Kitty.AccentText" Color="#D12A5F" />
            <SolidColorBrush x:Key="Kitty.OnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Kitty.Danger" Color="#C42B1C" />
            <SolidColorBrush x:Key="Kitty.ErrorFill" Color="#0DC42B1C" />
            <SolidColorBrush x:Key="Kitty.ErrorStroke" Color="#2EC42B1C" />
            <SolidColorBrush x:Key="Kitty.WarningFill" Color="#0D9D5D00" />
            <SolidColorBrush x:Key="Kitty.WarningStroke" Color="#2E9D5D00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Kitty.Fill.Hover" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="Kitty.Fill.Selected" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Kitty.Fill.Control" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="Kitty.Hairline" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Kitty.Card" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="Kitty.CardSolid" Color="#2B2B2B" />
            <SolidColorBrush x:Key="Kitty.Input" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="Kitty.Accent" Color="#FF375F" />
            <SolidColorBrush x:Key="Kitty.AccentText" Color="#FF6B8D" />
            <SolidColorBrush x:Key="Kitty.OnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Kitty.Danger" Color="#FF6B5B" />
            <SolidColorBrush x:Key="Kitty.ErrorFill" Color="#16C42B1C" />
            <SolidColorBrush x:Key="Kitty.ErrorStroke" Color="#3DC42B1C" />
            <SolidColorBrush x:Key="Kitty.WarningFill" Color="#169D5D00" />
            <SolidColorBrush x:Key="Kitty.WarningStroke" Color="#3D9D5D00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Kitty.Fill.Hover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Kitty.Fill.Selected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Kitty.Fill.Control" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Kitty.Hairline" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Kitty.Card" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Kitty.CardSolid" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Kitty.Input" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Kitty.Accent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Kitty.AccentText" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Kitty.OnAccent" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="Kitty.Danger" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Kitty.ErrorFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Kitty.ErrorStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Kitty.WarningFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Kitty.WarningStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 圆角 -->
    <CornerRadius x:Key="Kitty.Corner.Window">8</CornerRadius>
    <CornerRadius x:Key="Kitty.Corner.Card">8</CornerRadius>
    <CornerRadius x:Key="Kitty.Corner.Control">4</CornerRadius>
    <CornerRadius x:Key="Kitty.Corner.Capsule">999</CornerRadius>

    <!-- 字号 -->
    <x:Double x:Key="Kitty.FontSize.Search">20</x:Double>
    <x:Double x:Key="Kitty.FontSize.Result">28</x:Double>
    <x:Double x:Key="Kitty.FontSize.Readout">22</x:Double>
    <x:Double x:Key="Kitty.FontSize.Reading">15</x:Double>
    <x:Double x:Key="Kitty.FontSize.RowTitle">14</x:Double>
    <x:Double x:Key="Kitty.FontSize.Body">14</x:Double>
    <x:Double x:Key="Kitty.FontSize.Label">12</x:Double>
    <x:Double x:Key="Kitty.FontSize.Meta">12</x:Double>
    <x:Double x:Key="Kitty.FontSize.GroupHeader">12</x:Double>
    <x:Double x:Key="Kitty.FontSize.KeyCap">11</x:Double>
    <x:Double x:Key="Kitty.FontSize.Code">12</x:Double>
    <x:Double x:Key="Kitty.FontSize.Brand">26</x:Double>

    <!-- 设置卡 -->
    <Style x:Key="Kitty.Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Kitty.Card}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Kitty.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Kitty.Corner.Card}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- 说明文字 -->
    <Style x:Key="Kitty.Text.Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource Kitty.FontSize.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Kitty.Text.Tertiary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource Kitty.FontSize.Meta}" />
    </Style>

    <!-- 键帽：中性底，主动作的键帽由代码套 Kitty.KeyCap.Primary -->
    <Style x:Key="Kitty.KeyCap" TargetType="Border">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Kitty.Corner.Control}" />
        <Setter Property="Background" Value="{ThemeResource Kitty.Fill.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Kitty.KeyCap.Primary" TargetType="Border">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Kitty.Corner.Control}" />
        <Setter Property="Background" Value="{ThemeResource Kitty.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 无边框输入框：搜索线 / 翻译输入用，不要 Fluent 的底部粗线 -->
    <Style x:Key="Kitty.Input" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource Kitty.Input}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Kitty.Hairline}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Kitty.Corner.Card}" />
        <Setter Property="FontSize" Value="{StaticResource Kitty.FontSize.Body}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>
</ResourceDictionary>
