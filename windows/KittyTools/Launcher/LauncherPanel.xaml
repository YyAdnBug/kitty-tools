<UserControl
    x:Class="KittyTools.LauncherPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <UserControl.Resources>
        <DataTemplate x:Key="LauncherRowTemplate" x:DataType="local:LauncherRow">
            <Grid Height="48" ColumnSpacing="10" Padding="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    CornerRadius="7"
                    Background="{x:Bind IconBackground}">
                    <Grid>
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="16"
                            Visibility="{x:Bind GlyphVisibility}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            Source="{x:Bind IconImage}"
                            Stretch="Uniform"
                            Width="28"
                            Height="28"
                            Visibility="{x:Bind ImageVisibility}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                    <TextBlock
                        Text="{x:Bind Subtitle}"
                        FontSize="12"
                        Opacity="0.65"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind KeyHint}"
                    FontSize="11"
                    Opacity="0.55"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="16,12,16,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            PlaceholderText="搜索应用、设置、命令…"
            FontSize="20"
            Height="56"
            VerticalContentAlignment="Center"
            TextChanged="OnSearchTextChanged" />

        <TextBlock
            x:Name="EmptyState"
            Grid.Row="1"
            Text="输入以搜索应用、设置、命令…"
            Opacity="0.45"
            FontSize="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <ListView
            x:Name="List"
            Grid.Row="1"
            ItemTemplate="{StaticResource LauncherRowTemplate}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionChanged="OnSelectionChanged"
            DoubleTapped="OnListDoubleTapped"
            RightTapped="OnListRightTapped"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.65"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="打开启动器设置"
                Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
