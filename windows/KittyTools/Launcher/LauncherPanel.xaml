<UserControl
    x:Class="KittyTools.LauncherPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:ui="using:KittyTools.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <!-- 照 mac LauncherPanelView：搜索线 56（含底下一条通栏发丝线）+ 列表（四周内缩 6，由代码放进 ListHost）+ 底栏 36，没有外边距。
         没有结果时 ListHost 里只有一行字；Ctrl+K 菜单也浮在 ListHost 里，锚在右下、右缘对着底栏的 Ctrl+K 键帽。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <ui:SearchLine x:Name="SearchLineControl" Grid.Row="0" />

        <Grid x:Name="ListHost" Grid.Row="1">
            <TextBlock
                x:Name="EmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="{StaticResource Kitty.FontSize.Body}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        </Grid>

        <!-- 底栏：左边选中项的种类（16 色块 + 种类名），右边「主动作 ↩」「操作 Ctrl+K」；没有齿轮（Ctrl+, 直达设置） -->
        <ui:PanelFooter x:Name="Footer" Grid.Row="2" />
    </Grid>
</UserControl>
