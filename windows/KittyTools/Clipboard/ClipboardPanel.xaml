<UserControl
    x:Class="KittyTools.ClipboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <UserControl.Resources>
        <Style x:Key="ClipRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ClipRowTemplate" x:DataType="local:ClipRow">
            <StackPanel>
                <TextBlock
                    Text="{x:Bind DateHeader}"
                    Visibility="{x:Bind DateHeaderVisibility}"
                    FontSize="{StaticResource Kitty.FontSize.GroupHeader}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="8,10,0,4" />
                <Grid Height="40" ColumnSpacing="10" Padding="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="5.5"
                        Background="{x:Bind IconBackground}"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Title}"
                        FontSize="{StaticResource Kitty.FontSize.RowTitle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock
                                Text="{x:Bind RightText}"
                                FontSize="{StaticResource Kitty.FontSize.Meta}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxWidth="90"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <FontIcon
                                Glyph="&#xE735;"
                                FontSize="11"
                                Foreground="{ThemeResource Kitty.Accent}"
                                Visibility="{x:Bind FavoriteVisibility}" />
                            <Border
                                Style="{StaticResource Kitty.KeyCap}"
                                Visibility="{x:Bind SnippetVisibility}">
                                <TextBlock Text="片段" FontSize="{StaticResource Kitty.FontSize.KeyCap}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind NoteText}"
                            Visibility="{x:Bind NoteVisibility}"
                            FontSize="{StaticResource Kitty.FontSize.Label}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            MaxWidth="150"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border
                        Grid.Column="3"
                        Style="{StaticResource Kitty.KeyCap}"
                        Visibility="{x:Bind KeyHintVisibility}">
                        <TextBlock
                            Text="{x:Bind KeyHint}"
                            FontSize="{StaticResource Kitty.FontSize.KeyCap}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="16,14,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="搜索剪贴板…"
                Style="{StaticResource Kitty.Input}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FontSize="{StaticResource Kitty.FontSize.Search}"
                Height="56"
                VerticalContentAlignment="Center"
                TextChanged="OnSearchTextChanged" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <ToggleButton
                    x:Name="AllScope"
                    Content="全部"
                    IsChecked="True"
                    Click="OnAllScopeClick" />
                <ToggleButton
                    x:Name="FavoriteScope"
                    Content="收藏"
                    Click="OnFavoriteScopeClick" />
                <ToggleButton
                    x:Name="SnippetScope"
                    Content="片段"
                    Click="OnSnippetScopeClick" />
                <ComboBox
                    x:Name="GroupFilter"
                    MinWidth="110"
                    PlaceholderText="收藏夹"
                    AutomationProperties.Name="收藏夹筛选"
                    Visibility="Collapsed"
                    SelectionChanged="OnGroupFilterChanged" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="Hint"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Border
                    x:Name="Highlight"
                    Height="40"
                    CornerRadius="4"
                    Background="{ThemeResource Kitty.Fill.Selected}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" />
                <ListView
                    x:Name="List"
                    ItemTemplate="{StaticResource ClipRowTemplate}"
                    ItemContainerStyle="{StaticResource ClipRowStyle}"
                    SelectionMode="Extended"
                    CanDragItems="True"
                    DragItemsStarting="OnDragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    SelectionChanged="OnSelectionChanged"
                    DoubleTapped="OnListDoubleTapped"
                    RightTapped="OnListRightTapped"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                    <FontIcon
                        Glyph="&#xE8C8;"
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="{StaticResource Kitty.FontSize.RowTitle}"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Column="1"
                Style="{StaticResource Kitty.Card}">
                <ScrollViewer
                    x:Name="PreviewScroll"
                    Padding="18,14,18,16"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PreviewHost" Spacing="10" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                FontSize="{StaticResource Kitty.FontSize.Meta}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="PinButton"
                Grid.Column="1"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="固定剪贴板面板"
                ToolTipService.ToolTip="固定面板（Ctrl+P）"
                Click="OnPinClick">
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </Button>
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="打开剪贴板设置"
                ToolTipService.ToolTip="设置"
                Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
