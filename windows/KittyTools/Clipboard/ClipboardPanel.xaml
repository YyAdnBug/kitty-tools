<UserControl
    x:Class="KittyTools.ClipboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <UserControl.Resources>
        <DataTemplate x:Key="ClipRowTemplate" x:DataType="local:ClipRow">
            <StackPanel Padding="4,2,4,2">
                <TextBlock
                    Text="{x:Bind DateHeader}"
                    Visibility="{x:Bind DateHeaderVisibility}"
                    FontSize="11"
                    Opacity="0.55"
                    Margin="4,8,0,4" />
                <Grid ColumnSpacing="10" Padding="4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        CornerRadius="6"
                        Background="{x:Bind IconBackground}">
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind Subtitle}"
                            FontSize="12"
                            Opacity="0.65"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            MaxLines="1" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Spacing="1">
                        <TextBlock
                            Text="{x:Bind Time}"
                            FontSize="11"
                            Opacity="0.6"
                            HorizontalAlignment="Right" />
                        <FontIcon
                            Glyph="&#xE735;"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Visibility="{x:Bind FavoriteVisibility}"
                            HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="16,14,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="搜索剪贴板…"
                FontSize="20"
                Height="56"
                VerticalContentAlignment="Center"
                TextChanged="OnSearchTextChanged" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <ToggleButton
                    x:Name="AllScope"
                    Content="全部"
                    IsChecked="True"
                    Click="OnAllScopeClick" />
                <ToggleButton
                    x:Name="FavoriteScope"
                    Content="收藏"
                    Click="OnFavoriteScopeClick" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="Hint"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="List"
                ItemTemplate="{StaticResource ClipRowTemplate}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                SelectionChanged="OnSelectionChanged"
                DoubleTapped="OnListDoubleTapped"
                RightTapped="OnListRightTapped"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <Border
                Grid.Column="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer
                    x:Name="PreviewScroll"
                    Padding="18,14,18,16"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PreviewHost" Spacing="10" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.65"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="打开剪贴板设置"
                Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
