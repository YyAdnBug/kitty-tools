<UserControl
    x:Class="KittyTools.ClipboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <UserControl.Resources>
        <Style x:Key="ClipRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ClipRowTemplate" x:DataType="local:ClipRow">
            <StackPanel>
                <TextBlock
                    Text="{x:Bind DateHeader}"
                    Visibility="{x:Bind DateHeaderVisibility}"
                    FontSize="11"
                    Opacity="0.55"
                    Margin="8,10,0,4" />
                <Grid Height="40" ColumnSpacing="10" Padding="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="6"
                        Background="{x:Bind IconBackground}"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Title}"
                        FontSize="14"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind RightText}"
                            FontSize="12"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <FontIcon
                            Glyph="&#xE735;"
                            FontSize="11"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Visibility="{x:Bind FavoriteVisibility}" />
                    </StackPanel>
                    <Border
                        Grid.Column="3"
                        MinWidth="18"
                        Height="18"
                        Padding="4,0"
                        CornerRadius="4"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        Visibility="{x:Bind KeyHintVisibility}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind KeyHint}"
                            FontSize="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="16,14,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="搜索剪贴板…"
                FontSize="20"
                Height="56"
                VerticalContentAlignment="Center"
                TextChanged="OnSearchTextChanged" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <ToggleButton
                    x:Name="AllScope"
                    Content="全部"
                    IsChecked="True"
                    Click="OnAllScopeClick" />
                <ToggleButton
                    x:Name="FavoriteScope"
                    Content="收藏"
                    Click="OnFavoriteScopeClick" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="Hint"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Border
                    x:Name="Highlight"
                    Height="40"
                    CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" />
                <ListView
                    x:Name="List"
                    ItemTemplate="{StaticResource ClipRowTemplate}"
                    ItemContainerStyle="{StaticResource ClipRowStyle}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    SelectionChanged="OnSelectionChanged"
                    DoubleTapped="OnListDoubleTapped"
                    RightTapped="OnListRightTapped"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8C8;" FontSize="26" Opacity="0.35" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Opacity="0.5" FontSize="13" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Column="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer
                    x:Name="PreviewScroll"
                    Padding="18,14,18,16"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PreviewHost" Spacing="10" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.65"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="打开剪贴板设置"
                ToolTipService.ToolTip="设置"
                Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
