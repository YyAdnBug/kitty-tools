<UserControl
    x:Class="KittyTools.ClipboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KittyTools"
    xmlns:ui="using:KittyTools.Ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <!-- 照 mac 的透镜指令条：搜索线 56（含底下一条发丝线）+ 列表 + 底栏 36，没有外边距；
         列表是 ClipListView（前缀和摆放，四周内缩 6），由代码放进 ListHost。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <ui:SearchLine x:Name="SearchLineControl" Grid.Row="0" />

        <Grid x:Name="ListHost" Grid.Row="1">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="EmptyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="{StaticResource Kitty.FontSize.RowTitle}"
                    VerticalAlignment="Center" />
                <HyperlinkButton
                    x:Name="EmptyClear"
                    Content="清除搜索和筛选"
                    Padding="0"
                    FontSize="{StaticResource Kitty.FontSize.RowTitle}"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    IsTabStop="False"
                    Click="OnEmptyClearClick" />
            </StackPanel>
        </Grid>

        <!-- PLAN-v7 §3.1 底栏：左「N 条」/ 就地提示，右「粘贴 ↩ · 操作 Ctrl+K ｜ 齿轮 图钉」 -->
        <ui:PanelFooter x:Name="Footer" Grid.Row="2" />
    </Grid>
</UserControl>
