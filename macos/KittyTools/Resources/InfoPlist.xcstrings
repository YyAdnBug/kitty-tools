{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets launcher system commands ask Finder to empty the Trash and show the system’s Log Out, Restart and Shut Down confirmations. When the notch can’t read what’s playing, Kitty Tools also uses it to play, pause and skip in Music or Spotify and to read Music’s playback position."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于启动器的系统命令：让访达清倒废纸篓，弹出退出登录、重新启动、关机的系统确认框；刘海岛读不到正在播放时，替「音乐」「Spotify」播放、暂停、切歌，读「音乐」播到哪"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a countdown to your next event in the notch (title, time, location and meeting link). Event details stay on this Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在刘海岛上显示下一个日程的倒数（标题、时间、地点和会议链接）；日程的内容只留在这台 Mac 上"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Kitty Tools open and reveal Desktop files you pick in the launcher or clipboard history, and create new files from the Finder menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于打开、显示你在启动器和剪贴板历史里选中的桌面文件，和在访达右键里新建文件"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Kitty Tools open and reveal Documents files you pick in the launcher or clipboard history, and create new files from the Finder menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于打开、显示你在启动器和剪贴板历史里选中的文稿文件，和在访达右键里新建文件"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Kitty Tools open and reveal Downloads files you pick in the launcher or clipboard history, and create new files from the Finder menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于打开、显示你在启动器和剪贴板历史里选中的下载文件，和在访达右键里新建文件"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects to translation services running on your local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于连接局域网内的大模型翻译服务"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist 权限说明（中文改 Config/Info.plist）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records your microphone while you record the screen or audio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于录屏和录音时录下麦克风的声音"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
