          }
        }
      }
    },
    "各页的设置、全局快捷键和功能开关；启动台、录音的麦克风、菜单栏图标这些跟着这台 Mac 的不同步" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings on every page, global shortcuts, and feature switches; things tied to this Mac, like Launchpad, the recording microphone, and the menu bar icon, aren’t synced"
          }
        }
      }
    },
    "各页的选项都还是默认值" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All options are still at their defaults"
          }
        }
      }
    },
    "各页里改过的 %lld 项，其余是默认值" : {
      "localizations" : {
