        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Human pronunciations come from Youdao Dictionary, so the word is sent to Youdao; when one isn’t available, a system voice is used. Sentences use system voices; you can download better voices in System Settings › Accessibility › Spoken Content."
          }
        }
      }
    },
