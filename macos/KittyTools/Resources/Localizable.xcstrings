        }
      }
    },
    "，含密钥" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", keys included"
          }
        }
      }
    },
    "，新增 %lld 条" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", %lld new"
          }
