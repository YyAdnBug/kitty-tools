          }
        }
      }
    },
    "占位符：{date} 日期、{time} 时间、{datetime} 日期和时间、{weekday} 星期几（能加偏移和格式：{date+1d}、{date-1w:yyyy/MM/dd}；单位 m 分钟、h 小时、d 天、w 周、M 月、y 年）、{uuid} 随机编号、{clipboard} 当前剪贴板、{clipboard:1}–{clipboard:9} 历史第 N 条文字（不算片段）、{input:称呼} 粘贴前填空、{cursor} 粘贴后光标停在这里" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeholders: {date} date, {time} time, {datetime} date and time, {weekday} day of the week (add an offset or a format: {date+1d}, {date-1w:yyyy/MM/dd}; units m minutes, h hours, d days, w weeks, M months, y years), {uuid} random ID, {clipboard} current clipboard, {clipboard:1}–{clipboard:9} Nth text item in history (not counting snippets), {input:Name} fill in before pasting, {cursor} where the cursor lands after pasting"
          }
        }
      }
    },
    "卡片背后的东西越靠近卡片越模糊；系统设置里开着「降低透明度」时不模糊" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What’s behind the card gets blurrier closer to it; no blur when Reduce Transparency is on in System Settings"
          }
        }
      }
    },
    "印地语" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi"
          }
        }
      }
    },
    "印尼语" : {
