<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 局部 Info.plist：构建时与 GENERATE_INFOPLIST_FILE 生成的内容合并，只放 INFOPLIST_KEY_* 表达不了的键（PLAN §8.1） -->
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
	</array>
	<key>KittyBuiltinZhipuKey</key>
	<string>$(ZHIPU_BUILTIN_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSDesktopFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的桌面文件</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的文稿文件</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的下载文件</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于连接局域网内的大模型翻译服务</string>
</dict>
</plist>
