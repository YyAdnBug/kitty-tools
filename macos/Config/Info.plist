<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 局部 Info.plist：构建时与 GENERATE_INFOPLIST_FILE 生成的内容合并，只放 INFOPLIST_KEY_* 表达不了的键（PLAN §8.1）。
     CFBundleLocalizations：简体中文、英文；zh-Hant 不建 lproj，只为让繁体中文的系统落回简体（不列它会落到英文，2026-11-15 实测）。
     下面几条权限说明的英文在 KittyTools/Resources/InfoPlist.xcstrings，改这里要一起改
     CFBundleURLTypes：App 自己的网址（scheme 就是 bundle id，Debug、Release 各认各的），访达扩展把右键的动作交过来（FinderLink） -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
		<string>zh-Hant</string>
	</array>
	<key>KittyBuiltinZhipuKey</key>
	<string>$(ZHIPU_BUILTIN_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSDesktopFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的桌面文件，和在访达右键里新建文件</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的文稿文件，和在访达右键里新建文件</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>用于打开、显示你在启动器和剪贴板历史里选中的下载文件，和在访达右键里新建文件</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>用于启动器的系统命令：让访达清倒废纸篓，弹出退出登录、重新启动、关机的系统确认框；刘海岛读不到正在播放时，替「音乐」「Spotify」播放、暂停、切歌，读「音乐」播到哪；访达工具栏上的「Kitty Tools」按钮在 iCloud 云盘、网盘的文件夹里问访达你选中了什么</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>用于在刘海岛上显示下一个日程的倒数（标题、时间、地点和会议链接）；日程的内容只留在这台 Mac 上</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于「睡眠关蓝牙」插件：电脑睡下去时关掉蓝牙、醒来时再打开</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于录屏和录音时录下麦克风的声音</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于连接局域网内的大模型翻译服务</string>
</dict>
</plist>
