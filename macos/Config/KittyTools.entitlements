<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 由 Base.xcconfig 的 CODE_SIGN_ENTITLEMENTS 引用；不开沙盒（ENABLE_APP_SANDBOX = NO）。
     apple-events：启动器系统命令（清倒废纸篓、退出登录 / 重新启动 / 关机），配 Info.plist 的 NSAppleEventsUsageDescription -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
